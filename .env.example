# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
MAX_BODY_BYTES=2097152
ENABLE_DOCS=true

REQUEST_TIMEOUT_MS=5000
RESOLVE_TIMEOUT_MS=2000

# --- CORS ---
CORS_ORIGINS=

# --- Auth/Keys ---
# disabling database is useful smoke testing, minimal CI jobs debugging APIs
DATABASE_DISABLED=true# local: true, staging/prod: false
API_KEY_HEADER=X-API-Key
API_KEY_HASH_SCHEME=argon2id
API_KEY_CACHE_TTL_SECONDS=0# local: 0, staging/prod: 60

# --- Observability ---
SENTRY_DSN=

# --- Database ---
POSTGRES_DB=unacronym
POSTGRES_USER=unacronym
POSTGRES_PASSWORD=test-password
POSTGRES_PORT=5432

# When running API inside Docker Compose, use "db" as hostname
# DATABASE_URL=postgresql+psycopg://unacronym:test-password@db:5432/unacronym

# When running API directly on host (outside Compose), use localhost
DATABASE_URL_SYNC=postgresql+psycopg://unacronym:test-password@localhost:5432/unacronym
DATABASE_URL_ASYNC=postgresql+asyncpg://unacronym:test-password@localhost:5432/unacronym

# used to update openapi versions, set to 1 to update 0 to keep / comparison versions
UPDATE_SNAPSHOTS=0

# WEB APP VARIABLES

NEXT_PUBLIC_API_BASE_URL=http://api:8000
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_ENABLE_ANALYTICS=false
UNACRONYM_API_KEY=devkey

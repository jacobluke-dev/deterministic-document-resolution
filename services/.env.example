# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
MAX_BODY_BYTES=2097152
ENABLE_DOCS=true

REQUEST_TIMEOUT_MS=5000
RESOLVE_TIMEOUT_MS=2000

# --- CORS ---
CORS_ORIGINS=

# --- Auth/Keys ---
AUTH_DISABLED=true# local: true, staging/prod: false
API_KEY_HEADER=X-API-Key
API_KEY_HASH_SCHEME=argon2id
API_KEY_CACHE_TTL_SECONDS=0# local: 0, staging/prod: 60

# --- Observability ---
SENTRY_DSN=

# --- Database ---
# Local development DSN (staging/prod from secrets)
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/unacronym

# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
MAX_BODY_BYTES=2097152
ENABLE_DOCS=true

REQUEST_TIMEOUT_MS=5000
RESOLVE_TIMEOUT_MS=2000

# --- CORS ---
CORS_ORIGINS=

# --- Auth/Keys ---
# local: true, staging/prod: false
AUTH_DISABLED=true
API_KEY_HEADER=X-API-Key
API_KEY_HASH_SCHEME=argon2id
# local: 0, staging/prod: 60
API_KEY_CACHE_TTL_SECONDS=0

# --- Observability ---
SENTRY_DSN=

# --- Database ---
POSTGRES_DB=unacronym
POSTGRES_USER=unacronym
POSTGRES_PASSWORD=test-password
POSTGRES_PORT=5432

# When running API inside Docker Compose, use "db" as hostname
# DATABASE_URL=postgresql+psycopg://unacronym:test-password@db:5432/unacronym

# When running API directly on host (outside Compose), use localhost
DATABASE_URL=postgresql+psycopg://unacronym:test-password@localhost:5432/unacronym

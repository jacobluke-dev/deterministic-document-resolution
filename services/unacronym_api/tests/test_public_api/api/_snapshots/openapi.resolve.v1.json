{
  "components": {
    "schemas": {
      "CandidateProvenance": {
        "enum": [
          "document",
          "glossary",
          "seed",
          "system"
        ],
        "title": "CandidateProvenance",
        "type": "string"
      },
      "Definition": {
        "properties": {
          "confidence": {
            "description": "0\u20131 confidence score for this definition.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "End offset (exclusive).",
            "title": "End"
          },
          "source": {
            "$ref": "#/components/schemas/DefinitionSource",
            "description": "Origin of the definition: extracted|glossary."
          },
          "start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Start offset of definition text if found in source text.",
            "title": "Start"
          },
          "text": {
            "description": "Expanded form of the acronym.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "confidence",
          "source"
        ],
        "title": "Definition",
        "type": "object"
      },
      "DefinitionSource": {
        "enum": [
          "extracted",
          "glossary"
        ],
        "title": "DefinitionSource",
        "type": "string"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine-readable enum."
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Structured diagnostics (limit, actual, etc.).",
            "title": "Details"
          },
          "message": {
            "description": "Human-readable error.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "FORBIDDEN",
          "UNAUTHENTICATED",
          "BAD_REQUEST",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "UNPROCESSABLE_ENTITY",
          "TOO_MANY_REQUESTS",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GlossaryBlock": {
        "properties": {
          "matches": {
            "items": {
              "$ref": "#/components/schemas/GlossaryMatch"
            },
            "title": "Matches",
            "type": "array"
          }
        },
        "title": "GlossaryBlock",
        "type": "object"
      },
      "GlossaryMatch": {
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "definition": {
            "title": "Definition",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Domain tag if known, else null.",
            "title": "Domain"
          },
          "lang": {
            "description": "ISO language tag.",
            "maxLength": 10,
            "minLength": 2,
            "title": "Lang",
            "type": "string"
          },
          "source": {
            "const": "system",
            "default": "system",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "definition",
          "lang",
          "confidence"
        ],
        "title": "GlossaryMatch",
        "type": "object"
      },
      "HealthCheckResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthCheckResponse",
        "type": "object"
      },
      "ResolutionMode": {
        "description": "Deterministic resolution policy for selecting a final acronym meaning.\n\nSTRICT:\n    Select only when the resolver can do so conservatively. Avoid permissive\n    fallback behaviour and prefer leaving the acronym unresolved when\n    multiple glossary candidates remain.\n\nDOMAIN_PRIORITY:\n    Use the standard deterministic policy. Prefer the strongest available\n    candidate according to the resolver's normal ordering and fallback\n    rules. This is the default balanced mode.\n\nFALLBACK_GENERAL:\n    Prefer returning a usable result whenever possible. If no stronger\n    candidate is available, prefer a general-domain meaning before falling\n    back to the first deterministically ordered candidate.",
        "enum": [
          "strict",
          "domain_priority",
          "fallback_general"
        ],
        "title": "ResolutionMode",
        "type": "string"
      },
      "ResolveCandidate": {
        "properties": {
          "definition": {
            "description": "Candidate resolved meaning.",
            "title": "Definition",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Meaning/domain tag if known, else null.",
            "title": "Domain"
          },
          "provenance": {
            "$ref": "#/components/schemas/CandidateProvenance",
            "description": "Where the candidate came from."
          },
          "score": {
            "description": "Deterministic ranking score. In the MVP this is primarily used for candidate ordering, not calibrated confidence.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional stable source reference, e.g. text span or glossary meaning id.",
            "title": "Source Ref"
          }
        },
        "required": [
          "definition",
          "score",
          "provenance"
        ],
        "title": "ResolveCandidate",
        "type": "object"
      },
      "ResolveMeta": {
        "properties": {
          "input_chars": {
            "title": "Input Chars",
            "type": "integer"
          },
          "model_version": {
            "description": "plainera-core version used for processing.",
            "title": "Model Version",
            "type": "string"
          },
          "processing_ms": {
            "title": "Processing Ms",
            "type": "integer"
          },
          "resolution_mode": {
            "$ref": "#/components/schemas/ResolutionMode",
            "description": "Resolution policy applied during sense selection."
          }
        },
        "required": [
          "processing_ms",
          "model_version",
          "input_chars",
          "resolution_mode"
        ],
        "title": "ResolveMeta",
        "type": "object"
      },
      "ResolveOptions": {
        "properties": {
          "include_glossary_enrichment": {
            "default": true,
            "description": "If true, attempt curated joins from repository (read-only).",
            "title": "Include Glossary Enrichment",
            "type": "boolean"
          },
          "locale": {
            "default": "en-GB",
            "description": "Locale hint for heuristics. ISO BCP-47 tag. Supported: en-GB, en-US.",
            "title": "Locale",
            "type": "string"
          },
          "max_definitions_per_acronym": {
            "default": 5,
            "description": "Maximum candidate definitions/meanings to return per acronym.",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Definitions Per Acronym",
            "type": "integer"
          },
          "min_confidence": {
            "default": 0.0,
            "description": "Drop candidates below this confidence threshold.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Confidence",
            "type": "number"
          },
          "return_occurrences": {
            "default": true,
            "description": "If true, include all {start,end} positions.",
            "title": "Return Occurrences",
            "type": "boolean"
          },
          "window_chars": {
            "default": 120,
            "description": "Context window size used in responses.",
            "minimum": 0.0,
            "title": "Window Chars",
            "type": "integer"
          }
        },
        "title": "ResolveOptions",
        "type": "object"
      },
      "ResolveRequest": {
        "examples": [
          {
            "options": {
              "include_glossary_enrichment": true,
              "locale": "en-GB",
              "max_definitions_per_acronym": 5,
              "min_confidence": 0.0,
              "return_occurrences": true,
              "window_chars": 120
            },
            "resolution_mode": "domain_priority",
            "text": "The Metropolitan Police Service (MPS) operates in London."
          },
          {
            "text": ""
          }
        ],
        "properties": {
          "options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResolveOptions"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolution_mode": {
            "$ref": "#/components/schemas/ResolutionMode",
            "default": "domain_priority",
            "description": "Controls deterministic acronym sense selection policy."
          },
          "text": {
            "description": "Raw document content. Max length 100,000 characters.",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ResolveRequest",
        "type": "object"
      },
      "ResolveResponse": {
        "examples": [
          {
            "acronyms": [
              {
                "acronym": "GP",
                "candidates": [
                  {
                    "definition": "General Practitioner",
                    "provenance": "document",
                    "score": 1.0,
                    "source_ref": "text_span:4-24"
                  },
                  {
                    "definition": "General Partner",
                    "domain": "finance",
                    "provenance": "glossary",
                    "score": 0.0,
                    "source_ref": "meaning:42"
                  }
                ],
                "conflict": true,
                "conflict_count": 2,
                "definitions": [
                  {
                    "confidence": 0.99,
                    "end": 24,
                    "source": "extracted",
                    "start": 4,
                    "text": "General Practitioner"
                  }
                ],
                "first_occurrence": {
                  "end": 35,
                  "start": 33
                },
                "glossary": {
                  "matches": [
                    {
                      "confidence": 0.98,
                      "definition": "General Practitioner",
                      "domain": "medical",
                      "lang": "en",
                      "source": "system"
                    },
                    {
                      "confidence": 0.82,
                      "definition": "General Partner",
                      "domain": "finance",
                      "lang": "en",
                      "source": "system"
                    }
                  ]
                },
                "occurrences": [
                  {
                    "end": 35,
                    "start": 33
                  }
                ],
                "selected": {
                  "definition": "General Practitioner",
                  "reason": "in_document_definition"
                },
                "selection": {
                  "filtered_inactive_count": 0
                }
              }
            ],
            "meta": {
              "input_chars": 68,
              "model_version": "plainera-core@1.0.0",
              "processing_ms": 12,
              "resolution_mode": "domain_priority"
            }
          }
        ],
        "properties": {
          "acronyms": {
            "items": {
              "$ref": "#/components/schemas/ResolvedAcronymBlock"
            },
            "title": "Acronyms",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ResolveMeta"
          }
        },
        "required": [
          "meta"
        ],
        "title": "ResolveResponse",
        "type": "object"
      },
      "ResolvedAcronymBlock": {
        "properties": {
          "acronym": {
            "description": "Surface form exactly as detected (no lowercasing).",
            "title": "Acronym",
            "type": "string"
          },
          "candidates": {
            "description": "Ordered candidate meaning, best to worst, bounded by request cap.",
            "items": {
              "$ref": "#/components/schemas/ResolveCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "conflict": {
            "default": false,
            "description": "True when more than one viable candidate existed.",
            "title": "Conflict",
            "type": "boolean"
          },
          "conflict_count": {
            "default": 0,
            "description": "Number of viable candidates considered after filtering.",
            "minimum": 0.0,
            "title": "Conflict Count",
            "type": "integer"
          },
          "definitions": {
            "description": "Candidate definitions for this acronym (ranked by confidence).",
            "items": {
              "$ref": "#/components/schemas/Definition"
            },
            "title": "Definitions",
            "type": "array"
          },
          "first_occurrence": {
            "$ref": "#/components/schemas/Span",
            "description": "First occurrence offsets in Python-slice semantics (end exclusive)."
          },
          "glossary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GlossaryBlock"
              },
              {
                "type": "null"
              }
            ],
            "description": "Curated matches present when enrichment is enabled/available."
          },
          "occurrences": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Span"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "All occurrences when return_occurrences=true.",
            "title": "Occurrences"
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SelectedCandidate"
              },
              {
                "type": "null"
              }
            ],
            "description": "Chosen candidate when at least one viable meaning exists."
          },
          "selection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SelectionMeta"
              },
              {
                "type": "null"
              }
            ],
            "description": "Additional deterministic selection metadata."
          }
        },
        "required": [
          "acronym",
          "first_occurrence"
        ],
        "title": "ResolvedAcronymBlock",
        "type": "object"
      },
      "SelectedCandidate": {
        "properties": {
          "definition": {
            "description": "Chosen resolved meaning.",
            "title": "Definition",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Selected meaning/domain tag if known, else null.",
            "title": "Domain"
          },
          "reason": {
            "$ref": "#/components/schemas/SelectionReason",
            "description": "Deterministic selection reason."
          }
        },
        "required": [
          "definition",
          "reason"
        ],
        "title": "SelectedCandidate",
        "type": "object"
      },
      "SelectionMeta": {
        "properties": {
          "filtered_inactive_count": {
            "default": 0,
            "description": "Number of inactive candidates removed before selection.",
            "minimum": 0.0,
            "title": "Filtered Inactive Count",
            "type": "integer"
          },
          "policy_used": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional deterministic policy identifier used during selection.",
            "title": "Policy Used"
          }
        },
        "title": "SelectionMeta",
        "type": "object"
      },
      "SelectionReason": {
        "enum": [
          "in_document_definition",
          "single_candidate",
          "highest_score",
          "fallback_general",
          "inactive_filtered",
          "exact_domain_match",
          "domain_priority_policy"
        ],
        "title": "SelectionReason",
        "type": "string"
      },
      "Span": {
        "properties": {
          "end": {
            "description": "End offset (exclusive).",
            "title": "End",
            "type": "integer"
          },
          "start": {
            "description": "Start offset (inclusive).",
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "Span",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Unacronym API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/resolve": {
      "post": {
        "description": "Detect acronyms, propose definitions, and (optionally) enrich from a curated glossary. Offsets use Python-slice semantics (end exclusive). Supported locales: en-GB, en-US. Idempotent: does not mutate server state. Content-Encoding: gzip supported.",
        "operationId": "resolve_acronyms_v1_resolve_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Body-Limit-Bytes": {
                "description": "Current configured body size limit.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Input-Bytes": {
                "description": "Parsed request body size in bytes.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Limit": {
                "description": "Requests allowed in window.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Remaining in current window.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "description": "Epoch seconds until window resets.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Request-ID": {
                "description": "Echoed or generated correlation id.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Resolve acronyms in raw text",
        "tags": [
          "Resolve"
        ]
      }
    }
  }
}

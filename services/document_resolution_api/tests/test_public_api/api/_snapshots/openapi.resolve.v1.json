          "chosen_meaning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DefinedTermMeaningRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Resolved meaning record when available."
          },
          "chosen_meaning_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }

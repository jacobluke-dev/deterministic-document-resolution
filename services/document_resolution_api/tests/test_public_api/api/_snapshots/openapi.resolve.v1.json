                "type": "null"
              }
            ],
            "description": "Curated matches present when enrichment is enabled/available."
          },
          "occurrences": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Span"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "All occurrences when return_occurrences=true.",
            "title": "Occurrences"
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SelectedCandidate"
              },
              {
                "type": "null"
              }
            ],
            "description": "Chosen candidate when at least one viable meaning exists."
          },
          "selection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SelectionMeta"
              },
              {
                "type": "null"
              }
            ],
            "description": "Additional deterministic selection metadata."
          }
        },
        "required": [
          "acronym",
          "first_occurrence"
        ],
        "title": "ResolvedAcronymBlock",
        "type": "object"
      },
      "SelectedCandidate": {
        "properties": {
          "definition": {
            "description": "Chosen resolved meaning.",
            "title": "Definition",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Selected meaning/domain tag if known, else null.",
            "title": "Domain"
          },
          "reason": {
            "$ref": "#/components/schemas/SelectionReason",
            "description": "Deterministic selection reason."
          }
        },
        "required": [
          "definition",
          "reason"
        ],
        "title": "SelectedCandidate",
        "type": "object"
      },
      "SelectionMeta": {
        "properties": {
          "filtered_inactive_count": {
            "default": 0,
            "description": "Number of inactive candidates removed before selection.",
            "minimum": 0.0,
            "title": "Filtered Inactive Count",
            "type": "integer"
          }
        },
        "title": "SelectionMeta",
        "type": "object"
      },
      "SelectionReason": {
        "enum": [
          "in_document_definition",
          "single_candidate",
          "highest_score",
          "fallback_general",
          "inactive_filtered",
          "exact_domain_match",
          "domain_priority_policy"
        ],
        "title": "SelectionReason",
        "type": "string"
      },
      "Span": {
        "properties": {
          "end": {
            "description": "End offset (exclusive).",
            "title": "End",
            "type": "integer"
          },
          "start": {
            "description": "Start offset (inclusive).",
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "Span",
        "type": "object"
      },
      "StructuralReferenceBlock": {
        "properties": {
          "canonical_key": {
            "description": "Canonical lookup key used for linking.",
            "title": "Canonical Key",
            "type": "string"
          },
          "canonical_label": {
            "description": "Canonicalized label used for deterministic matching.",
            "title": "Canonical Label",
            "type": "string"
          },
          "kind": {
            "description": "Structural reference kind, for example Section or Schedule.",
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "description": "Source-close detected label text.",
            "title": "Label",
            "type": "string"
          },
          "match_strategy": {
            "description": "Deterministic positional strategy used to resolve the link.",
            "enum": [
              "forward",
              "backward",
              "overlap",
              "unresolved"
            ],
            "title": "Match Strategy",
            "type": "string"
          },
          "normalized_key": {
            "description": "Normalized structural key.",
            "title": "Normalized Key",
            "type": "string"
          },
          "provenance": {
            "description": "Provenance tag for the structural reference.",
            "title": "Provenance",
            "type": "string"
          },
          "reference_span": {
            "$ref": "#/components/schemas/Span",
            "description": "Occurrence span of the structural reference."
          },
          "resolved": {
            "description": "True when the occurrence resolved to a target span.",
            "title": "Resolved",
            "type": "boolean"
          },
          "strength": {
            "description": "Deterministic link-strength score. Ordinal heuristic, not calibrated confidence.",
            "minimum": 0.0,
            "title": "Strength",
            "type": "number"
          },
          "target_span": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Span"
              },
              {
                "type": "null"
              }
            ],
            "description": "Resolved target heading span, or null if unresolved."
          }
        },
        "required": [
          "kind",
          "label",
          "canonical_label",
          "normalized_key",
          "canonical_key",
          "reference_span",
          "match_strategy",
          "strength",
          "provenance",
          "resolved"
        ],
        "title": "StructuralReferenceBlock",
        "type": "object"
      },
      "TextSpan": {
        "properties": {
          "end": {
            "description": "Exclusive end character offset.",
            "title": "End",
            "type": "integer"
          },
          "start": {
            "description": "Inclusive start character offset.",
            "title": "Start",
            "type": "integer"
          },
          "text": {
            "description": "The given text field",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "start",
          "end"
        ],
        "title": "TextSpan",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "document_resolution API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/resolve": {
      "post": {
        "description": "Resolve acronyms, defined terms, and structural references from raw document text. The response may include occurrence-level results, deterministic resolution metadata, and structured partial-success reporting by pipeline. Offsets use Python-slice semantics (end exclusive). Supported locales: en-GB, en-US. Idempotent: does not mutate server state. Content-Encoding: gzip supported.",
        "operationId": "resolve_document_v1_resolve_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Body-Limit-Bytes": {
                "description": "Current configured body size limit.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Input-Bytes": {
                "description": "Parsed request body size in bytes.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Limit": {
                "description": "Requests allowed in window.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Remaining in current window.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "description": "Epoch seconds until window resets.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Request-ID": {
                "description": "Echoed or generated correlation id.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Resolve acronyms, defined terms, and structural references in raw text",
        "tags": [
          "Resolve"
        ]
      }
    }
  }
}
